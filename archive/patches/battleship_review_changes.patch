+def code_fingerprint():
+    """Hash of the source that determines game outcomes."""
+    h = hashlib.sha256()
+    for name in ("engine.py", "strategies.py"):
+        h.update(name.encode())
+        h.update((ROOT / name).read_bytes().replace(b"\r\n", b"\n"))
+    return h.hexdigest()[:16]
