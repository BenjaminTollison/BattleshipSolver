+    assert search.outcome(fleet, 7, 0)[0] == "miss"
+    assert search.outcome(fleet, 0, 0)[:2] == ("hit", None)
+    assert search.outcome(fleet, 2, 0b011)[:2] == ("sunk", "Carrier")
